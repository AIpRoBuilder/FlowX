# ── LLM configuration (used by meta_agent.AgentBuilder) ──────────────────────
# Provider: deepseek | openai | zhipu | qwen | 111api
FLOWX_LLM_PROVIDER=deepseek
FLOWX_LLM_MODEL=deepseek-chat
FLOWX_LLM_API_KEY=""
# Optional override for OpenAI-compatible base URL
# FLOWX_LLM_BASE_URL=

# ── Default workspace (parent dir for generated workflows) ───────────────────
FLOWX_DEFAULT_WORKSPACE=/home/testuser/flowx_workspaces

# ── Optional: extra sys.path entries (colon-separated) if meta_agent /
#    ag_ui_workflow are NOT pip-installed editable. ───────────────────────────
# FLOWX_EXTRA_PATHS=/Users/xiechuxi/Desktop/codes/meta_agent:/Users/xiechuxi/Desktop/codes/ag_ui_worflow
