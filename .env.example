# LLM configuration used by meta_agent.AgentBuilder
# Provider examples: deepseek | openai | zhipu | qwen | 111api
FLOWX_LLM_PROVIDER=deepseek
FLOWX_LLM_MODEL=deepseek-chat
FLOWX_LLM_API_KEY=
# Optional override for OpenAI-compatible providers
# FLOWX_LLM_BASE_URL=

# Parent directory for generated workflows. Relative paths are resolved from the
# process working directory.
FLOWX_DEFAULT_WORKSPACE=./.flowx_workspaces

# Optional directory that contains a .env file when you run an installed
# `flowx-mcp` command outside the repository checkout.
# FLOWX_CONFIG_ROOT=/path/to/flowx-config

# Optional extra source roots for local sibling checkouts when the workflow
# packages are not installed into the current environment.
# macOS / Linux example:
# FLOWX_EXTRA_PATHS=../meta_agent:../ag_ui_workflow